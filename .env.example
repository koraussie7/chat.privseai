# privseai-trystero environment configuration
# Copy to .env and adjust values as needed

# ── privseai.com app URLs ──
VITE_PUBLIC_APP_NAME=PrivseAI
VITE_PUBLIC_APP_URL=https://privseai.com
VITE_PUBLIC_API_URL=https://api.privseai.com

# ── Fellowship node API (Colibri WASM inference) ──
VITE_FELLOWSHIP_URL=http://localhost:3001

# ── Trystero P2P signaling ──
# Options: nostr, torrent, mqtt, supabase, firebase, ipfs, ws-relay
VITE_TRYSTERO_STRATEGY=nostr
VITE_TRYSTERO_APP_ID=privseai-p2pclaw
