# privseai-trystero environment configuration
# Copy to .env and adjust values as needed

# ── privseai.com app URLs ──
VITE_PUBLIC_APP_NAME=PrivseAI
VITE_PUBLIC_APP_URL=https://privseai.com
VITE_PUBLIC_API_URL=https://api.privseai.com

# ── Fellowship node API (Colibri WASM inference) ──
VITE_FELLOWSHIP_URL=http://localhost:3001

# ── Trystero P2P signaling ──
# Options: nostr, torrent, mqtt, supabase, firebase, ipfs, ws-relay
VITE_TRYSTERO_STRATEGY=nostr
VITE_TRYSTERO_APP_ID=privseai-p2pclaw

# Nostr relays for WebRTC signaling (comma-separated).
# Falls back to NOSTR_RELAY_FALLBACKS in config.ts if empty.
# Current fallbacks (no expired certs):
#   wss://nos.lol,wss://nostr.rblb.it,wss://relay.nostrmap.net,
#   wss://nostr.red5d.dev,wss://nostr.stakey.net,wss://nostrcity-club.fly.dev,wss://relay.aarpia.com
VITE_NOSTR_RELAYS=

# ── Colibri gateway advertisement (opt-in) ──
# Distributed inference only works if peers can *find* each other. The client could
# broadcast a colibri-gateway action but nothing called it, so colibriPeers was always
# empty. Enable ONLY once VITE_FELLOWSHIP_URL is a publicly reachable origin: the hook
# refuses to advertise localhost/127.0.0.1 and CandyChatPage filters those out anyway.
VITE_COLIBRI_ADVERT_ENABLED=false
# How often to re-broadcast the gateway action, in ms (default 60000). Trystero does
# not replay past actions, so late joiners need a periodic refresh.
VITE_COLIBRI_ADVERT_INTERVAL_MS=60000
