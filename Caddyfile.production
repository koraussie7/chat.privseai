# Caddy Configuration for privseai.com
# Place at /etc/caddy/Caddyfile
# Run: sudo caddy run --config /etc/caddy/Caddyfile

{
    admin off
    auto_https off
    email admin@privseai.com
}

# ============================================
# Main Site: privseai.com
# ============================================
privseai.com, www.privseai.com {
    root * /var/www/privseai/dist
    file_server

    # SPA fallback
    try_files {path} /index.html

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Gzip compression
    encode zstd gzip

    # Cache static assets
    @static {
        path /assets/*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # ── freellmpool quota-gateway (pooled free LLMs, per-user quotas) ──
    # /freellm/* -> quota-gateway on :4005 -> freellmpool on :8080.
    # The browser sends its per-user qp_… key as Bearer; Caddy only relays.
    @freellm {
        path /freellm/*
    }
    handle @freellm {
        uri strip_prefix /freellm
        reverse_proxy 127.0.0.1:4005
    }

    # ── BYOK passthrough (user's own key, server never stores it) ──
    # /api/byok/<provider>/* -> provider upstream, Authorization forwarded untouched.
    # The browser calls same-origin so CORS is avoided; Caddy only relays.
    @byok_openai {
        path /api/byok/openai/*
    }
    handle @byok_openai {
        uri strip_prefix /api/byok/openai
        reverse_proxy https://api.openai.com {
            header_up Host api.openai.com
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    @byok_anthropic {
        path /api/byok/anthropic/*
    }
    handle @byok_anthropic {
        uri strip_prefix /api/byok/anthropic
        reverse_proxy https://api.anthropic.com {
            header_up Host api.anthropic.com
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    @byok_gemini {
        path /api/byok/gemini/*
    }
    handle @byok_gemini {
        uri strip_prefix /api/byok/gemini
        reverse_proxy https://generativelanguage.googleapis.com {
            header_up Host generativelanguage.googleapis.com
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    @byok_openrouter {
        path /api/byok/openrouter/*
    }
    handle @byok_openrouter {
        uri strip_prefix /api/byok/openrouter
        reverse_proxy https://openrouter.ai {
            header_up Host openrouter.ai
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # API proxy -> LiteLLM (port 4003)
    handle /api/* {
        reverse_proxy http://localhost:4003 {
            header_up Host {http.request.host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            lb_try_duration 5s
            lb_try_interval 250ms
        }
    }

    # Health endpoint (no auth)
    handle /health {
        respond 200 "OK"
    }

    # P2P signaling (Trystero/Nostr)
    handle /p2p* {
        reverse_proxy http://localhost:8080 {
            header_up Host {http.request.host}
            header_up Upgrade {http.request.header.Upgrade}
            header_up Connection "upgrade"
        }
    }
}

# ============================================
# API Subdomain: api.privseai.com
# ============================================
api.privseai.com {
    reverse_proxy http://localhost:4003 {
        header_up Host {http.request.host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        lb_try_duration 5s
        lb_try_interval 250ms
    }

    # Health endpoint
    handle /health {
        respond 200 "OK"
    }

    # Rate limiting
    ratelimit {
        zone api 100r/s
        key {remote_host}
    }
}

# ============================================
# Fellowship/Colibri Subdomain (Tier 2)
# ============================================
fellowship.privseai.com {
    reverse_proxy http://localhost:3001 {
        header_up Host {http.request.host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    handle /health {
        respond 200 "OK"
    }
}

# ============================================
# Girlfriend.ai Subdomain (Tier 3)
# ============================================
gf.privseai.com {
    reverse_proxy http://localhost:3002 {
        header_up Host {http.request.host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    handle /health {
        respond 200 "OK"
    }
}

# ============================================
# OmniRoute Subdomain (Tier 1.5 - Optional)
# ============================================
omniroute.privseai.com {
    reverse_proxy http://localhost:4000 {
        header_up Host {http.request.host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    handle /health {
        respond 200 "OK"
    }
}